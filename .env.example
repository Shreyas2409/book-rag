# Neo4j Configuration
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=pass

# Agent API URL (used by UI)
AGENT_API=http://localhost:7005

# Ollama Configuration (optional, defaults to host.docker.internal:11434)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chroma Directory (optional, for local vector storage fallback)
# CHROMA_DIR=./chroma/books

# ── New in v2 ──────────────────────────────────────────────────────────

# Eval Agent (LLM-as-Judge)
EVAL_ENABLED=true
# EVAL_MODEL=llama3.1:8b  # model used by the judge (same Ollama instance)

# ReAct Agent
MAX_REACT_STEPS=6             # max Thought/Action/Observation loops per query

# Context Window
MAX_HISTORY_TURNS=10          # sliding window size for conversation memory
CONTEXT_BUDGET_CHARS=12000    # max chars assembled in the prompt
SUMMARY_TRIGGER=6             # summarise after this many turns

# Observability
LOG_LEVEL=INFO

# ── New in v3 ──────────────────────────────────────────────────────────

# Reranking (cross-encoder for higher retrieval precision)
RERANK_ENABLED=true           # set to false to disable reranking

# Input Validation
MAX_QUERY_LENGTH=2000         # max characters per user query

# Agentic Correction Loop
CORRECTION_THRESHOLD=0.5      # retry if avg eval score < this threshold

# Trace Persistence
# TRACE_FILE=./traces.jsonl   # traces are appended here for persistence

# ── New in v4 ──────────────────────────────────────────────────────────

# Hybrid Search (Vector + BM25)
HYBRID_SEARCH_ENABLED=false   # set to true to enable BM25 + vector fusion (default: false = vector-only)
HYBRID_BLEND_WEIGHT=0.7       # α: 0.0 = pure BM25, 1.0 = pure vector, 0.7 = recommended default

# ── New in v5 ──────────────────────────────────────────────────────────

# Groq (optional extra LLM provider, used as an alternative to Ollama)
# The API key itself is NOT configured here — it is entered in the UI
# per-session and sent to agent_api as a request header. Never put a
# real Groq key in this file or commit it.
# GROQ_MODEL=llama-3.1-8b-instant        # used for the main agent LLM
# GROQ_EVAL_MODEL=llama-3.1-8b-instant   # used by the eval judge
# GROQ_SUMMARY_MODEL=llama-3.1-8b-instant # used for history summarisation
